{
  "info": {
    "name": "Strava-Lite System",
    "description": "API requests to interact with the Strava-Lite backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Signup User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.email) {",
              "    pm.environment.set('user_email', jsonData.email);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Recruiter Demo\",\n    \"email\": \"demo@example.com\",\n    \"password\": \"interview123\",\n    \"age\": 32,\n    \"weight\": 165\n}"
        },
        "url": { "raw": "{{base_url}}/auth/signup", "host": ["{{base_url}}"], "path": ["auth", "signup"] }
      }
    },
    {
      "name": "2. Login & Get JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.environment.set('jwt_token', jsonData.token);",
              "    pm.environment.set('user_id', jsonData.user.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"demo@example.com\",\n    \"password\": \"interview123\"\n}"
        },
        "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "3. Add a Run",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"duration\": 2100,\n    \"distance\": 5.5\n}"
        },
        "url": { "raw": "{{base_url}}/runs/{{user_id}}", "host": ["{{base_url}}"], "path": ["runs", "{{user_id}}"] }
      }
    },
    {
      "name": "4. Check Analytics (Cached)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": { "raw": "{{base_url}}/analytics/{{user_id}}", "host": ["{{base_url}}"], "path": ["analytics", "{{user_id}}"] }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    }
  ]
}
